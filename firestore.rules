rules_version = '2';
// Deny by default. The worker writes through the emulator's admin bypass,
// so agent messages and presence are not constrained here; a later order
// gives agents real credentials.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(cid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.memberIds;
    }

    function validMessage(cid, mid) {
      let m = request.resource.data;
      return m.keys().hasOnly(['id', 'conversationId', 'authorId', 'text',
                               'delivery', 'emphasis', 'sentAt', 'inReplyTo'])
        && m.keys().hasAll(['id', 'conversationId', 'authorId', 'text',
                            'delivery', 'emphasis', 'sentAt'])
        && m.authorId == request.auth.uid
        && m.id == mid
        && m.conversationId == cid
        && m.sentAt == request.time
        && m.text is string
        && m.text.size() >= 1
        && m.text.size() <= 4000
        && m.text.matches('(?s).*\\S.*')
        && m.delivery in ['plain', 'typed', 'headline', 'aside', 'credits']
        && m.emphasis is list
        && m.emphasis.size() <= 8
        && (!('inReplyTo' in m)
            || (m.inReplyTo is string
                && m.inReplyTo.size() >= 1
                && m.inReplyTo.size() <= 128))
        && validEmphasisAt(m, 0) && validEmphasisAt(m, 1)
        && validEmphasisAt(m, 2) && validEmphasisAt(m, 3)
        && validEmphasisAt(m, 4) && validEmphasisAt(m, 5)
        && validEmphasisAt(m, 6) && validEmphasisAt(m, 7);
    }

    function validSpan(text, e) {
      return e is map
        && e.keys().hasOnly(['from', 'to'])
        && e.keys().hasAll(['from', 'to'])
        && e.from is int
        && e.to is int
        && 0 <= e.from
        && e.from < e.to
        && e.to <= text.size();
    }

    // Rules have no loops: the size cap of 8 bounds the indexes, and an index
    // past the end of the list is vacuously valid.
    function validEmphasisAt(m, i) {
      return m.emphasis.size() <= i || validSpan(m.text, m.emphasis[i]);
    }

    function validPresence(cid, memberId) {
      let p = request.resource.data;
      return p.keys().hasOnly(['memberId', 'conversationId', 'state', 'since'])
        && p.keys().hasAll(['memberId', 'conversationId', 'state', 'since'])
        && p.memberId == memberId
        && p.conversationId == cid
        && p.state in ['idle', 'thinking']
        && p.since == request.time;
    }

    match /members/{memberId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    match /conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      match /messages/{mid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && validMessage(cid, mid);
      }

      match /presence/{memberId} {
        allow read: if isMember(cid);
        allow create, update: if memberId == request.auth.uid
          && isMember(cid)
          && validPresence(cid, memberId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
